#!/bin/bash
# Focus the first Herdr pane that requires attention, ordered by priority:
#   1. blocked — agent needs operator intervention
#   2. done    — agent finished, output unseen
#
# Usage:
#   herdr-focus-attention.sh         — jump to the first attention pane
#   herdr-focus-attention.sh next    — cycle to the next attention pane after the current one
set -uo pipefail

# Collect panes that require attention, ordered by priority (blocked before done).
# Each line: "workspace_id tab_id pane_id"
attention=$(herdr pane list 2>/dev/null | jq -r '
  .result.panes
  | map(select(.agent_status == "blocked" or .agent_status == "done"))
  | sort_by(.agent_status == "done")
  | .[]
  | "\(.workspace_id) \(.tab_id) \(.pane_id)"
' 2>/dev/null || true)

if [ -z "$attention" ]; then
  exit 0
fi

target=""

if [ "${1:-}" = "next" ]; then
  # Cycle: find the current pane in the attention list and pick the one after it.
  current_pane=$(herdr pane current 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)

  found_current=false
  first_line=""
  while IFS= read -r line; do
    [ -z "$first_line" ] && first_line="$line"
    pane_id="${line##* }"
    if [ "$found_current" = true ]; then
      target="$line"
      break
    fi
    [ "$pane_id" = "$current_pane" ] && found_current=true
  done <<< "$attention"

  # Current pane not in the list, or it was the last — wrap to the first.
  [ -z "$target" ] && target="$first_line"
else
  target=$(echo "$attention" | head -1)
fi

[ -z "$target" ] && exit 0

read -r ws tab _pane <<< "$target"
herdr workspace focus "$ws" 2>/dev/null || true
herdr tab focus "$tab" 2>/dev/null || true
