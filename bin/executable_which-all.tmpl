"""List every executable on PATH for a given name, in PATH priority order.

Shell aliases are resolved so that ``which-all <alias>`` lists the
executables the shell would actually run.
"""

import functools
import os
import shlex
import shutil
import subprocess
import sys


def find_in_path(name):
    """Return all executable matches for *name* found on PATH.

    *name* may also be an absolute or relative path.
    """
    name = os.path.expandvars(os.path.expanduser(name))
    matches = []

    # If the caller passed a path, check it directly instead of searching PATH.
    if os.path.isabs(name) or "/" in name or name.startswith(("./", "../")):
        if os.path.isfile(name) and os.access(name, os.X_OK):
            matches.append((1, name, os.path.realpath(name), None))
        return matches

    seen_real = {}
    rank = 0
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            directory = "."
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            rank += 1
            real = os.path.realpath(candidate)
            duplicate_of = seen_real.get(real)
            if not duplicate_of:
                seen_real[real] = rank
            matches.append((rank, candidate, real, duplicate_of))
    return matches


def _is_assignment(token):
    """Return True if *token* is a shell variable assignment like FOO=bar."""
    if token.startswith("="):
        return False
    if "=" not in token:
        return False
    before, _, _ = token.partition("=")
    return before.isidentifier()


def _tokenize_alias(expansion):
    """Split an alias expansion into shell words, skipping leading VAR= assignments."""
    if not expansion:
        return []
    try:
        tokens = shlex.split(expansion)
    except ValueError:
        tokens = expansion.split()
    while tokens and _is_assignment(tokens[0]):
        tokens = tokens[1:]
    return tokens


def _find_zsh():
    """Return the path to a usable zsh binary, or None."""
    for candidate in (shutil.which("zsh"), "/bin/zsh", "/usr/bin/zsh", "/opt/homebrew/bin/zsh"):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


@functools.lru_cache(maxsize=None)
def _collect_aliases():
    """Return a dict of alias name -> expansion from the current shell config.

    A lightweight zsh startup loads ~/.bash_aliases and ~/.zsh_keys, and only
    sources ~/.bash.d shell files that declare aliases, then dumps the alias
    table.
    """
    zsh = _find_zsh()
    if zsh is None:
        return {}

    script = r'''
_contains_alias() {
  # Heuristic: only source ~/.bash.d files that actually declare aliases,
  # so token/env-only files are skipped without hardcoding names.
  [[ -f "$1" ]] && grep -qE '^[[:space:]]*alias[[:space:]]+[^[:space:]=]+=' "$1" 2>/dev/null
}

source() {
  local f="$1"
  local should_source=0
  case "$f" in
    .aliases|*/.aliases|*/.bash_aliases|*/.zsh_keys) should_source=1 ;;
    *.sh|*.zsh|*.bash) _contains_alias "$f" && should_source=1 ;;
  esac
  (( should_source )) || return 0
  builtin source "$@"
}

_chpwd_aliases() { [ -f .aliases ] && source .aliases 2>/dev/null; }
chpwd_functions+=(_chpwd_aliases)

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

cd "${PWD:-.}" 2>/dev/null || true
source ~/.bash_aliases 2>/dev/null
source ~/.zsh_keys 2>/dev/null

for k v in ${(kv)aliases}; do
  print -r -- "ALIAS:$k=$v"
done
'''
    try:
        result = subprocess.run(
            [zsh, "-c", script],
            capture_output=True,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}

    if result.returncode != 0:
        return {}

    aliases = {}
    for line in result.stdout.splitlines():
        if not line.startswith("ALIAS:"):
            continue
        line = line[len("ALIAS:"):]
        if "=" not in line:
            continue
        name, value = line.split("=", 1)
        if name:
            aliases[name] = value
    return aliases


def _resolve_alias_target(name, aliases, seen=None):
    """Recursively resolve *name* through alias chains to the final command word."""
    if seen is None:
        seen = set()
    if name in seen:
        return name
    expansion = aliases.get(name)
    if expansion is None:
        return name
    seen = seen | {name}
    tokens = _tokenize_alias(expansion)
    if not tokens:
        return name
    return _resolve_alias_target(tokens[0], aliases, seen)


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    if not argv:
        print(
            f"usage: {os.path.basename(sys.argv[0])} <program> [<program> ...]",
            file=sys.stderr,
        )
        return 1

    aliases = _collect_aliases()

    any_missing = False
    for name in argv:
        target = _resolve_alias_target(name, aliases)
        expansion = aliases.get(name)
        matches = find_in_path(target)

        if not matches:
            msg = f"{name}: not found on PATH"
            if expansion and expansion != name:
                msg = f"{name}: aliased to {expansion}; {target}: not found on PATH"
            print(msg, file=sys.stderr)
            any_missing = True
            continue

        header = None
        if expansion and expansion != name:
            header = f"{name}: aliased to {expansion}"
        elif len(argv) > 1:
            header = f"{name}:"
        if header:
            print(header)

        for rank, candidate, real, duplicate_of in matches:
            line = f"  [{rank}] {candidate}"
            if real != os.path.abspath(candidate):
                line += f" -> {real}"
            if duplicate_of:
                line += f" (same real path as #{duplicate_of})"
            print(line)

    return 1 if any_missing else 0


if __name__ == "__main__":
    sys.exit(main())
