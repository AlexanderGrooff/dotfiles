# This file is managed by chezmoi. Do not edit directly. Source: {{ .chezmoi.sourceFile }}
[theme]
name = "tokyo-night"
auto_switch = false

[theme.custom]
# Tokyo Night palette for a dark purple UI vibe.
accent = "#bb9af7"
panel_bg = "#16161e"
surface0 = "#292e42"
surface1 = "#2f334d"
surface_dim = "#1a1b26"
overlay0 = "#565f89"
overlay1 = "#787c99"
text = "#a9b1d6"
subtext0 = "#787c99"
mauve = "#bb9af7"
green = "#9ece6a"
yellow = "#e0af68"
red = "#f7768e"
blue = "#7aa2f7"
teal = "#7dcfff"
peach = "#ff9e64"

[ui.toast]
delivery = "herdr"
delay_seconds = 1

[ui.toast.herdr]
position = "bottom-right"

[ui]
show_agent_labels_on_pane_borders = true
agent_panel_sort = "spaces"
prompt_new_tab_name = false
pane_borders = true
pane_gaps = true

[ui.sidebar.agents]
row_gap = 0
rows = [
  ["state_icon", { token = "workspace", bold = true }, "state_text", { token = "agent", fg = "#a9b1d6" }],
]

[ui.sidebar.spaces]
row_gap = 0
rows = [
  ["state_icon", { token = "workspace", bold = true }],
  [{ token = "branch", fg = "#565f89" }, "git_status"],
]

[terminal]
shell_mode = "login"
new_cwd = "home"

[[keys.command]]
key = "prefix+d"
type = "plugin_action"
command = "bead-dispatcher.select-ready"
description = "open dispatch selector"

[[keys.command]]
key = "prefix+shift+d"
type = "plugin_action"
command = "bead-dispatcher.dispatch-ready"
description = "dispatch all ready beads"

[[keys.command]]
key = "prefix+shift+b"
type = "shell"
command = "herdr plugin pane open --plugin bead-dispatcher --entrypoint board"
description = "open beads board"

[[keys.command]]
key = "cmd+r"
type = "plugin_action"
command = "persiyanov.reviewr.toggle"

[experimental]
pane_history = true
