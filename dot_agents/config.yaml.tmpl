{{- /* ~/.agents/config.private.yaml is an untracked, machine-local fragment (work laptop). */ -}}
{{- $private := stat (joinPath .chezmoi.homeDir ".agents" "config.private.yaml") -}}
apiVersion: agent-marketplace/v4
{{- if $private }}
# The private fragment sets harnesses; a value here would override it.
include: config.private.yaml
{{- else }}
harnesses:
  - cursor
  - codex
{{- end }}
sources:
  agent-marketplace:
    git: git@github.com:Adyen/agent-marketplace
    ref: main
    path: skills
  pstack:
    git: git@github.com:cursor/plugins
    ref: main
    path: pstack/skills
  mattpocock:
    git: git@github.com:mattpocock/skills
    ref: main
    path: skills
  skills:
    git: git@github.com:mattpocock/skills
    ref: main
    path: skills/productivity
    source_harness: claude
  skills-2:
    git: git@github.com:mattpocock/skills
    ref: main
    path: skills/engineering
    source_harness: claude
  skills-3:
    git: git@github.com:mattpocock/skills
    ref: main
    path: skills/misc
    source_harness: claude
resources:
  agent-marketplace:
    include:
      - skill/agent-marketplace
  pstack:
    include: [skill/unslop]
  mattpocock:
    include: []
  skills:
    include:
      - skill/grill-me
      - skill/grilling
      - skill/writing-for-agents
  skills-2:
    include:
      - skill/grill-with-docs
      - skill/improve-codebase-architecture
      - skill/code-review
      - skill/to-spec
      - skill/to-tickets
  skills-3:
    include:
      - skill/setup-pre-commit
